      "native",
      "linux-musl-openssl-3.0.x"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.8.2",
    "amqplib": "^0.10.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^6.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.6",
    "prisma": "^6.8.2",
    "vitest": "^3.2.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
