{
  "name": "@crash/wallets",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/main.ts",
    "start": "node src/main.ts",
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "prisma": {
