PORT=4001
# Local dev on host (bun run dev). Inside Docker Compose these are set in docker-compose.yml.
DATABASE_URL=postgresql://admin:admin@localhost:5432/games
RABBITMQ_URL=amqp://admin:admin@localhost:5672
# JWKS: use localhost when the service runs on your machine; use http://keycloak:8080/... from another container.
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/crash-game/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8080/realms/crash-game
