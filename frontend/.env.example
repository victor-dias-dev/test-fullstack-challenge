# Browser calls Kong (REST). Copy to .env for local `bun run dev` if needed.
VITE_API_URL=http://localhost:8000
# WebSocket connects directly to the games service (not proxied by Kong in this setup).
VITE_SOCKET_URL=http://localhost:4001
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=crash-game
VITE_KEYCLOAK_CLIENT_ID=crash-game-client
